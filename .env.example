# Optional. Public Kalshi / Polymarket market data works with these blank.

# Kalshi Key ID from kalshi.com → Settings → API Keys (optional)
KALSHI_KEY_ID=

# Supabase pooler URI if you want Postgres. Not required for the live board.
# Project Settings → Database → Connect → Transaction pooler → URI
DATABASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Fernet key for encrypted venue credentials. Never commit a real value.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Comma-separated browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:3000

# Set ENV=production on the API host. Leave unset for local dev.
ENV=
SECRET_KEY=

PORT=5000
FLASK_DEBUG=1
