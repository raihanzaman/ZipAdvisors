# Supabase / Postgres. Paste the connection URI from:
# Project Settings → Database → Connect → Transaction or Session pooler → URI
# Replace [YOUR-PASSWORD] with the database password you set at project create.
#
# Example:
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Direct (IPv6) alternative from the same Connect dialog:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Optional. Same values as Project Settings → API.
# Not required for this Flask app (it talks to Postgres via DATABASE_URL).
SUPABASE_URL=
SUPABASE_ANON_KEY=

PORT=5000
FLASK_DEBUG=1
